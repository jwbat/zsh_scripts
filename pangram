#! python
import json
from sys import argv
from os.path import expanduser, join
from random import randint
from colored import fg


DIR          = expanduser('~')
FNAME        = 'words_alpha.txt'
fpath        = join(DIR, FNAME)

color_codes  = [221, 157, 160, 6, 9, 209]
randcolor    = lambda : fg(color_codes[randint(0, len(color_codes) - 1)])
pprint       = lambda s: print(randcolor() + s.rjust(25))

letter_set   = set(argv[1].lower())
num_letters  = len(letter_set)


def decor(f):
    def g(*args):
        print()
        pprint('~' * 12)
        f(*args)
        pprint('~' * 12)
        print()
    return g


@decor
def solve(letter_set):
    with open(fpath, 'r') as f:
        for line in f:
            word = line.strip()
            if len(word) >= num_letters and set(word) == letter_set:
                pprint(word)


solve(letter_set)
